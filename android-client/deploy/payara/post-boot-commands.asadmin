# Payara (Micro or Server 6) asadmin commands that create the pooled MySQL DataSource used by SCASP.
# The password is NOT stored here: ${ENV=SCASP_DB_PASSWORD} is resolved by Payara from the environment.
# Edit serverName/portNumber/databaseName for your MySQL server.
create-jdbc-connection-pool --datasourceclassname=com.mysql.cj.jdbc.MysqlDataSource --restype=javax.sql.DataSource --steadypoolsize=2 --maxpoolsize=16 --isconnectvalidatereq=true --validationmethod=auto-commit --property serverName=127.0.0.1:portNumber=3306:databaseName=scasp:user=scasp:password=${ENV=SCASP_DB_PASSWORD}:useSSL=false:allowPublicKeyRetrieval=true:characterEncoding=UTF-8 scasp-pool
create-jdbc-resource --connectionpoolid=scasp-pool jdbc/scasp
