<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.scasp</groupId><artifactId>scasp-parent</artifactId><version>1.0.0</version></parent>
  <artifactId>scasp-web</artifactId>
  <packaging>war</packaging>
  <name>SCASP web application (Servlets + JSP)</name>
  <dependencies>
    <dependency><groupId>com.scasp</groupId><artifactId>scasp-core</artifactId></dependency>
    <dependency><groupId>com.scasp</groupId><artifactId>scasp-persistence-jdbc</artifactId></dependency>
    <dependency><groupId>com.scasp</groupId><artifactId>scasp-enterprise-services</artifactId></dependency>
    <!-- Payara 6 provides the Jakarta EE 10 APIs, including JSTL (jakarta.tags.core). -->
    <dependency><groupId>jakarta.platform</groupId><artifactId>jakarta.jakartaee-api</artifactId></dependency>
    <!-- Expression Language implementation for unit-testing RecordELResolver outside the server. -->
    <dependency><groupId>org.glassfish.expressly</groupId><artifactId>expressly</artifactId><version>5.0.0</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <finalName>scasp</finalName>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-war-plugin</artifactId>
        <configuration><failOnMissingWebXml>false</failOnMissingWebXml></configuration></plugin>
    </plugins>
  </build>
</project>
